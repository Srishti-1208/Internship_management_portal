{
  "name": "internship-portal-backend",
  "version": "1.0.0",
  "description": "Backend for Internship Management Portal (Auth, Attendance, Analytics modules)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "db:init": "psql -U $npm_config_dbuser -d $npm_config_dbname -f src/db/schema.sql",
    "db:seed": "psql -U $npm_config_dbuser -d $npm_config_dbname -f src/db/seed.sql"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}
